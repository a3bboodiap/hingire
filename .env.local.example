# Copy to .env.local and fill in. See SETUP.md for where each value comes from.
# .env.local is gitignored. Never commit real values.

# --- Supabase (Project Settings -> API keys) -------------------------------
# Safe in the browser: the anon key is public by design and every table it can
# reach is gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (optional) --------------------------------------------------
# SECRET, server-side only. Leave blank to run the six AI tasks on the
# built-in offline engine instead.
ANTHROPIC_API_KEY=

# --- App -------------------------------------------------------------------
# e.g. http://localhost:3000 locally, your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=

# SECRET. Any long random string; salts hashed IPs in the rate-limit table.
RATE_LIMIT_SALT=
